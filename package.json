{
  "name": "@credenza3/partner-sdk",
  "version": "1.1.0-rc.5",
  "description": "Credenza partner sdk",
  "author": "Credenza",
  "repository": {
    "type": "git",
    "url": "https://github.com/credenza-web3/credenza-partner-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --fix --deny-warnings src",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "dotenv": "^17.4.2",
    "lefthook": "^1.11.13",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
